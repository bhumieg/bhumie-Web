datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  OWNER
  ADMIN
}

enum PropertyPurpose {
  RENT
  SALE
}

enum PropertyStatus {
  PENDING
  ACTIVE
  REJECTED
  RENTED
  SOLD
}

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  name          String?
  phone         String?
  role          Role           @default(USER)
  isVerified    Boolean        @default(false)
  avatar        String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  properties           Property[]     @relation("UserProperties")
  favorites            Favorite[]
  inquiries            Inquiry[]
  conversationsAsBuyer Conversation[] @relation("BuyerConversations")
  conversationsAsOwner Conversation[] @relation("OwnerConversations")
  sentMessages         ChatMessage[]  @relation("SentMessages")

  @@map("users")
}

model OtpVerification {
  id        String   @id @default(cuid())
  email     String
  otp       String
  purpose   String   @default("LOGIN")
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email])
  @@map("otp_verifications")
}

model Property {
  id              String          @id @default(cuid())
  title           String
  description     String?
  propertyType    String          // House, Flat, Shop, Office, Room, PG
  purpose         PropertyPurpose @default(RENT)
  bhk             String          // 1 RK, 1 BHK, 2 BHK, 3 BHK, 4+ BHK
  carpetArea      Int?            // in sq.ft
  furnishing      String          // Furnished, Semi Furnished, Unfurnished
  monthlyRent     Float?
  securityDeposit Float?
  maintenance     Float?
  otherCharges    String?
  priceValue      Float           // numeric for sorting/filtering
  priceDisplay    String          // e.g. "₹18,000 /month"
  bedrooms        Int             @default(1)
  bathrooms       Int             @default(1)
  floor           String?
  totalFloors     String?
  availableFrom   String?
  ageOfProperty   String?
  address         String?
  locality        String          // Sector 62, Saket, etc.
  city            String          @default("Delhi-NCR")
  state           String?         @default("Delhi")
  pincode         String?
  latitude        Float?
  longitude       Float?
  images          String[]        @default([])
  videoUrl        String?
  amenities       String[]        @default([])
  verified        Boolean         @default(false)
  featured        Boolean         @default(false)
  status          PropertyStatus  @default(ACTIVE)

  ownerId         String
  ownerName       String?
  ownerEmail      String?
  ownerPhone      String?
  owner           User            @relation("UserProperties", fields: [ownerId], references: [id], onDelete: Cascade)

  favorites       Favorite[]
  inquiries       Inquiry[]
  conversations   Conversation[]

  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([city])
  @@index([locality])
  @@index([propertyType])
  @@index([purpose])
  @@index([priceValue])
  @@index([ownerId])
  @@map("properties")
}

model Favorite {
  id         String   @id @default(cuid())
  userId     String
  propertyId String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, propertyId])
  @@map("favorites")
}

model Inquiry {
  id         String   @id @default(cuid())
  propertyId String
  userId     String?
  name       String
  phone      String
  email      String?
  message    String?
  status     String   @default("NEW")
  createdAt  DateTime @default(now())

  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("inquiries")
}

model Conversation {
  id            String        @id @default(cuid())
  propertyId    String
  buyerId       String
  ownerId       String
  lastMessage   String?
  lastMessageAt DateTime      @default(now())
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  property      Property      @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  buyer         User          @relation("BuyerConversations", fields: [buyerId], references: [id], onDelete: Cascade)
  owner         User          @relation("OwnerConversations", fields: [ownerId], references: [id], onDelete: Cascade)
  messages      ChatMessage[]

  @@unique([propertyId, buyerId])
  @@index([buyerId])
  @@index([ownerId])
  @@index([propertyId])
  @@map("conversations")
}

model ChatMessage {
  id             String       @id @default(cuid())
  conversationId String
  senderId       String
  text           String
  isRead         Boolean      @default(false)
  createdAt      DateTime     @default(now())

  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@map("chat_messages")
}

